    "test:js": "node --test static/js/tests/*.test.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.70.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
